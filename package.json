{
  "name": "dcterminal",
  "private": true,
  "version": "0.1.0",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ui": "vite",
    "dev:app": "tauri dev",
    "dev:full": "tauri dev",
    "dev:stable": "npm run build && tauri dev --no-dev-server",
    "build": "tsc && vite build",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "check": "node scripts/local-check.mjs",
    "install-app": "node scripts/install-app.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "release:win": "tauri build --bundles nsis,msi",
    "release:mac": "tauri build --bundles app,dmg",
    "release:linux": "tauri build --bundles deb,appimage",
    "build:roles": "cargo run --bin build_roles_seed --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.7",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
