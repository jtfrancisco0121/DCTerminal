{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DCTerminal",
  "version": "0.1.0",
  "identifier": "com.jtfrancisco.dcterminal",
  "build": {
    "beforeDevCommand": "node scripts/ensure-vite-dev.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DCTerminal",
        "width": 1400,
        "height": 900,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "appimage"],
    "publisher": "JT Francisco",
    "homepage": "https://github.com/jtfrancisco0121/DCTerminal",
    "category": "DeveloperTool",
    "shortDescription": "Role-aware multi-tab UI for the Cursor CLI",
    "longDescription": "DCTerminal is a local desktop app that runs role-aware, multi-tab sessions on top of the Cursor CLI via ACP.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
